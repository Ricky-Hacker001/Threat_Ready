NODE_ENV=development
PORT=3000

# API connects as the non-owner role (RLS applies); migrations use the owner.
DATABASE_URL=postgres://threatready_app:app_dev_password@127.0.0.1:5432/threatready
DATABASE_MIGRATION_URL=postgres://threatready_owner:owner_dev_password@127.0.0.1:5432/threatready

# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# Public origin that serves /api (same origin as the SPA when /api is routed through Cloudflare)
BETTER_AUTH_URL=http://localhost:5173
# Origin of the SPA (trusted origin for redirects, CSRF and CORS)
WEB_ORIGIN=http://localhost:5173

# OAuth (providers are enabled only when both values are set)
# Redirect URIs: ${BETTER_AUTH_URL}/api/auth/callback/google and .../callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile. Leave empty in local dev to disable.
# Cloudflare test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email: "log" prints to stdout and exposes /api/dev/mailbox (refused in production); "ses" uses AWS SES v2
EMAIL_DRIVER=log
EMAIL_FROM="ThreatReady <no-reply@threatready.io>"
AWS_REGION=ap-south-1

# Client IP header, set ONLY when a trusted proxy writes it: the Vite dev proxy (x-forwarded-for) locally,
# the platform gateway (x-threatready-client-ip) on Render, cf-connecting-ip behind Cloudflare -> ALB (the
# ALB only accepts Cloudflare ranges). Unset: the TCP peer is the client and no header is believed.
CLIENT_IP_HEADER=x-forwarded-for

# Guest sessions ("Continue as a guest", /sign-in/anonymous). Off unless the apps accept trial users.
TRIAL_ENABLED=false
# Per-account sign-in lockout: failures before a lock (0 = off) and the first lock's minutes (doubles, max a day).
# A browser that signed in to the username before has its own count instead (auth/limits.ts, device tokens).
SIGNIN_LOCKOUT_FAILURES=5
SIGNIN_LOCKOUT_MINUTES=15
# Verification/reset codes per address and hour: from one client IP, and from everywhere (0 = no cap); a browser
# that signed in to the account is held to the per-IP cap only.
OTP_ISSUE_PER_IP_PER_HOUR=5
OTP_ISSUE_PER_EMAIL_PER_HOUR=20
# Activity pings per signed-in user and minute, and a per-IP backstop for a classroom NAT (0 = no limit).
ACTIVITY_PING_PER_USER_PER_MINUTE=20
ACTIVITY_PING_PER_IP_PER_MINUTE=600
# Per-IP backstop on the session read every onboard page makes (0 = exempt from the per-IP limiter, the default).
AUTH_GET_SESSION_PER_IP_PER_MINUTE=0
# Clean-up of expired sessions/codes, never-verified username/password sign-ups and old guests (0 hours = off; at most 576).
RETENTION_INTERVAL_HOURS=24
RETENTION_UNVERIFIED_DAYS=30
RETENTION_GUEST_DAYS=7

# Error tracking: a Sentry project DSN (optional; without it errors are only in the logs).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Release name on error reports (default: RENDER_GIT_COMMIT when set).
# RELEASE=

# ---------------------------------------------------------------------------
# Platform: onboard is the identity provider for every ThreatReady app.
# ---------------------------------------------------------------------------
# Production: COOKIE_DOMAIN=threatready.io (one sign-in for *.threatready.io).
# Leave empty locally: localhost cookies ignore the port, so every app shares them.
COOKIE_DOMAIN=

# Shared secret for /internal/* calls in both directions. Same value in the
# InterviewPrep and Labs .env files.   openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters-xxxxxxxx
# Per-caller tokens (the launcher, deploy/start.mjs, derives them from INTERNAL_API_TOKEN; see
# deploy/README.md). Unset locally: INTERNAL_API_TOKEN is then used both ways.
# INTERNAL_TOKENS_ACCEPT is comma-separated, one token per app calling /api/internal/*; each
# INTERNAL_TOKEN_TO_* is the token presented to that app's /internal/v1/*.
# INTERNAL_TOKENS_ACCEPT=
# INTERNAL_TOKEN_TO_INTERVIEW=
# INTERNAL_TOKEN_TO_LABS=
# INTERNAL_TOKEN_TO_AR=
# Accept the raw INTERNAL_API_TOKEN next to INTERNAL_TOKENS_ACCEPT (default: false in production).
# INTERNAL_TOKEN_LEGACY_ACCEPT=

# Platform admins (comma-separated, verified emails). Or: pnpm --filter @threatready/api admin:grant <email>
ADMIN_EMAILS=

# Where the browser is sent (public origins)
#   production: https://interviewprep.threatready.io, https://labs.threatready.io, https://ar.threatready.io
INTERVIEW_APP_URL=http://localhost:5174
LABS_APP_URL=http://localhost:5175/labs/
REASONING_APP_URL=http://localhost:5176/ar/
# Where onboard reaches each app's API server-side (in-VPC). Defaults to the public origin.
INTERVIEW_INTERNAL_URL=http://localhost:3100
LABS_INTERNAL_URL=http://localhost:4000/labs
REASONING_INTERNAL_URL=http://localhost:4100/ar
# live | soon. "soon" shows the app as coming soon and makes no calls to it.
INTERVIEW_STATUS=live
LABS_STATUS=live
REASONING_STATUS=live

# Business accounts (organisations). ORG_APPROVAL_REQUIRED=true creates each new organisation as "pending" until a
# platform admin approves it in the admin console; off = self-serve. Trial seats/days, invitation link lifetime, and
# the daily invitation email caps per organisation and for the whole platform (0 = none). Invitations share the email
# account with sign-up and sign-in codes: keep ORG_INVITES_PLATFORM_PER_DAY under the provider's daily quota.
# One address gets at most 3 invitation emails a day. See docs/BUSINESS_ACCOUNTS.md.
ORG_APPROVAL_REQUIRED=false
ORG_TRIAL_SEATS=5
ORG_TRIAL_DAYS=14
ORG_INVITE_TTL_DAYS=7
ORG_INVITES_PER_DAY=20
ORG_INVITES_PLATFORM_PER_DAY=50
