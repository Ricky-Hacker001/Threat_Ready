NODE_ENV=development
PORT=3000

# API connects as the non-owner role (RLS applies); migrations use the owner.
DATABASE_URL=postgres://threatready_app:app_dev_password@127.0.0.1:5432/threatready
DATABASE_MIGRATION_URL=postgres://threatready_owner:owner_dev_password@127.0.0.1:5432/threatready

# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# Public origin that serves /api (same origin as the SPA when /api is routed through Cloudflare)
BETTER_AUTH_URL=http://localhost:5173
# Origin of the SPA (trusted origin for redirects, CSRF and CORS)
WEB_ORIGIN=http://localhost:5173

# OAuth (providers are enabled only when both values are set)
# Redirect URIs: ${BETTER_AUTH_URL}/api/auth/callback/google and .../callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile. Leave empty in local dev to disable.
# Cloudflare test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email: "log" prints to stdout and exposes /api/dev/mailbox (refused in production); "ses" uses AWS SES v2
EMAIL_DRIVER=log
EMAIL_FROM="ThreatReady <no-reply@threatready.io>"
AWS_REGION=ap-south-1

# Client IP header. Behind Cloudflare -> ALB use cf-connecting-ip (the ALB only accepts Cloudflare ranges).
CLIENT_IP_HEADER=x-forwarded-for

# ---------------------------------------------------------------------------
# Platform: onboard is the identity provider for every ThreatReady app.
# ---------------------------------------------------------------------------
# Production: COOKIE_DOMAIN=threatready.io (one sign-in for *.threatready.io).
# Leave empty locally: localhost cookies ignore the port, so every app shares them.
COOKIE_DOMAIN=

# Shared secret for /internal/* calls in both directions. Same value in the
# InterviewPrep and Labs .env files.   openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters-xxxxxxxx

# Platform admins (comma-separated, verified emails). Or: pnpm --filter @threatready/api admin:grant <email>
ADMIN_EMAILS=

# Where the browser is sent (public origins)
#   production: https://interviewprep.threatready.io, https://labs.threatready.io, https://ar.threatready.io
INTERVIEW_APP_URL=http://localhost:5174
LABS_APP_URL=http://localhost:5175
REASONING_APP_URL=http://localhost:5176
# Where onboard reaches each app's API server-side (in-VPC). Defaults to the public origin.
INTERVIEW_INTERNAL_URL=http://localhost:3100
LABS_INTERNAL_URL=http://localhost:4000
REASONING_INTERNAL_URL=http://localhost:4100
# live | soon. "soon" shows the app as coming soon and makes no calls to it.
INTERVIEW_STATUS=live
LABS_STATUS=live
REASONING_STATUS=live
