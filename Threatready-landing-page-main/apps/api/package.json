{
  "name": "@threatready/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate.js",
    "test:routes": "node --test test/routes.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env --test test/e2e.test.mjs",
    "admin:grant": "node --env-file-if-exists=.env dist/db/grant-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1150.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@threatready/contracts": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.5",
    "drizzle-kit": "~0.31.11",
    "typescript": "5.9.3"
  }
}
