# ThreatReady Labs (labs.threatready.io). Copy to .env.
PORT=4000
# This app's public origin. Production: https://labs.threatready.io
APP_ORIGIN=http://localhost:5175
# Sign-in lives on onboard (the platform identity provider). Public origin, for links:
ONBOARD_URL=http://localhost:5173
# Where this server reaches onboard's API (in-VPC in AWS):
IDENTITY_URL=http://localhost:3000
# Same value as onboard's INTERNAL_API_TOKEN (shared secret for /internal/*).
INTERNAL_API_TOKEN=
# Seconds a resolved session is reused before asking onboard again.
IDENTITY_CACHE_SECONDS=30
# DATA_FILE=./data/store.json
# Per-caller tokens (set by deploy/start.mjs; optional locally). Accepted on /internal/*: the comma list in
# INTERNAL_TOKENS_ACCEPT, plus INTERNAL_API_TOKEN only when INTERNAL_TOKEN_LEGACY_ACCEPT=true (default off in production).
# Presented to onboard: INTERNAL_TOKEN_TO_ONBOARD (else INTERNAL_API_TOKEN).
# INTERNAL_TOKENS_ACCEPT=
# INTERNAL_TOKEN_LEGACY_ACCEPT=
# INTERNAL_TOKEN_TO_ONBOARD=
