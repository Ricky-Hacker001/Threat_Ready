# ThreatReady Labs (labs.threatready.io). Copy to .env.
PORT=4000
# This app's public origin. Production: https://labs.threatready.io
APP_ORIGIN=http://localhost:5175
# Sign-in lives on onboard (the platform identity provider). Public origin, for links:
ONBOARD_URL=http://localhost:5173
# Where this server reaches onboard's API (in-VPC in AWS):
IDENTITY_URL=http://localhost:3000
# Same value as onboard's INTERNAL_API_TOKEN (shared secret for /internal/*).
INTERNAL_API_TOKEN=
# Seconds a resolved session is reused before asking onboard again.
IDENTITY_CACHE_SECONDS=30
# DATA_FILE=./data/store.json
# Rate limits, requests per minute (0 disables): per signed-in learner, and per client IP for requests
# not yet known to be signed in (a learner the server already knows pays only the per-learner limit).
# LABS_RATE_PER_MIN=120
# LABS_RATE_IP_PER_MIN=300
# Onboard session lookups running at once, in total and per client IP (0 = no cap). Lookups past the
# per-IP cap wait up to 5 s for a slot; a session onboard confirmed in the last 12 h is never held back.
# LABS_IDENTITY_MAX_IN_FLIGHT=50
# LABS_IDENTITY_MAX_PER_CLIENT=16
# Runs kept per learner and lab; on reset the oldest archived runs go, the best one and the best completed one stay (0 keeps all).
# LABS_MAX_RUNS_PER_LAB=5
# Set by the ThreatReady launcher (deploy/start.mjs) while it keeps lab progress across restarts; the
# catalog then says "Saved to your ThreatReady account". Not set: "kept on the ThreatReady lab server".
# TR_STATE_DURABLE=1
# Standalone only: trust x-threatready-client-ip because a proxy in front sets it (the ThreatReady
# gateway always overwrites it). Off: the header is ignored and the socket address is used.
# LABS_TRUST_CLIENT_IP_HEADER=0
