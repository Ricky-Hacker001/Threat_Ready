{
  "name": "soc-sim",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SOC analyst simulation: live log stream, L1 triage, L2 investigation, L3 response, ticket closure",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node tests/run.mjs",
    "start:dev": "node scripts/start-dev.mjs",
    "lint:regexp": "node ../tools/check-regexp-from-input.mjs server"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
