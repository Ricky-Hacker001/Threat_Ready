# ThreatReady Attack Reasoning (ar.threatready.io). Copy to .env.
PORT=4100
# This app's public origin. Production: https://ar.threatready.io
APP_ORIGIN=http://localhost:5176
# Sign-in lives on onboard (the platform identity provider). Public origin, for links:
ONBOARD_URL=http://localhost:5173
# Where this server reaches onboard's API (in-VPC in AWS):
IDENTITY_URL=http://localhost:3000
# Same value as onboard's INTERNAL_API_TOKEN (shared secret for /internal/*).
INTERNAL_API_TOKEN=
IDENTITY_CACHE_SECONDS=30
# The reasoning engine: InterviewPrep's API (the ThreatReady monolith, module `reasoning`). In-VPC in AWS.
# Its ALLOWED_APP_ORIGINS must include this app's APP_ORIGIN.
REASONING_API_URL=http://localhost:3100
# Requests per minute per signed-in learner, and per client IP for traffic without a recognised session
# (a signed-in learner pays the per-IP bucket only when their session is looked up again, once every
# IDENTITY_CACHE_SECONDS, so a classroom behind one NAT is limited per learner). 0 disables.
AR_RATE_PER_MIN=120
AR_RATE_IP_PER_MIN=300
# Session lookups against onboard running at once, in total and per client IP (0 = no cap). Past the
# per-client cap a lookup waits up to 5 s for one of that client's slots (a classroom behind one NAT is
# served in waves); a session onboard confirmed in the last 12 hours is never shed.
AR_IDENTITY_MAX_IN_FLIGHT=50
AR_IDENTITY_MAX_PER_CLIENT=16
# Behind a reverse proxy: Express `trust proxy` (a hop count such as 1, "loopback", or its addresses).
# Unset: the connection's address is the visitor's and X-Forwarded-For is ignored.
# AR_TRUST_PROXY=1
# Set to 1 only when a proxy in front overwrites x-threatready-client-ip on every request; otherwise a
# client-sent value is dropped.
# AR_TRUST_CLIENT_IP_HEADER=1
