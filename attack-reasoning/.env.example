# ThreatReady Attack Reasoning (ar.threatready.io). Copy to .env.
PORT=4100
# This app's public origin. Production: https://ar.threatready.io
APP_ORIGIN=http://localhost:5176
# Sign-in lives on onboard (the platform identity provider). Public origin, for links:
ONBOARD_URL=http://localhost:5173
# Where this server reaches onboard's API (in-VPC in AWS):
IDENTITY_URL=http://localhost:3000
# Same value as onboard's INTERNAL_API_TOKEN (shared secret for /internal/*).
INTERNAL_API_TOKEN=
IDENTITY_CACHE_SECONDS=30
