# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets: never commit real environment files (templates are .env.example)
.env
.env.*
!.env.example

# Private keys and certificate bundles
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*

# Licensed asset: Renderpeople model, must not be publicly downloadable (see
# InterviewPrep/apps/web/src/features/interview-prep/avatar/ASSET_LICENSE.md). Deploy it out of band
# (Render Secret File). No other .glb is part of the platform, so none is committed.
InterviewPrep/apps/api/assets/interviewer.glb
**/interviewer.glb
*.glb

# The six sub-apps are separate clones with their own .git; they are published by
# scripts/publish.rsync-filter, which leaves every nested .git behind (check: scripts/publish-check.mjs).

# Local data: uploaded resumes/reports, bundled PostgreSQL, lab progress, logs
InterviewPrep/apps/api/var/
Threatready-landing-page-main/.local/
threatready-lab-001/data/*.json
soc/data/*.json
soc/data/*.tmp
red_team_lab/web/data/
.logs/
*.log
test-results/
.claude/
.DS_Store

# Internal audit reports (audit/) are tracked here but never published: scripts/publish.rsync-filter drops
# the folder and `scripts/publish-check.mjs --published` refuses a tree that still has it (audit/README.md).

# Python bytecode (site tools)
__pycache__/
