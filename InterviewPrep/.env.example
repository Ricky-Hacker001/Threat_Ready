# ---- Copy to .env for local development. In AWS these come from SSM Parameter Store
# ---- (SecureString) and Secrets Manager (DATABASE_URL), injected by ECS at task start.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (RDS in AWS). The API login role must be a member of tr_app_user and must NOT have
# BYPASSRLS; the worker role owns the tables. Locally one role is fine.
DATABASE_URL=postgres://threatready:threatready@localhost:55432/threatready
# WORKER_DATABASE_URL=postgres://tr_worker:...@.../threatready

APP_ORIGIN=http://localhost:5174
# Other ThreatReady origins that call this API with the shared session: the Attack Reasoning app (ar.threatready.io).
ALLOWED_APP_ORIGINS=http://localhost:5176
API_BASE_URL=http://localhost:5174
# Signs local-storage (fs) upload and download links. Falls back to BETTER_AUTH_SECRET when unset.
# STORAGE_SIGNING_SECRET=
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-secret-for-local-development-only
# Header a trusted gateway sets with the visitor's IP (IP-keyed limits on public routes); unset = req.ip.
# CLIENT_IP_HEADER=x-threatready-client-ip
# Sign-in lives on onboard.threatready.io (ThreatReady identity provider); no local login.
IDENTITY_URL=http://localhost:3000
ONBOARD_URL=http://localhost:5173
# Same value as onboard's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=
IDENTITY_CACHE_SECONDS=30

# Storage: s3 in every deployed environment (private bucket, ap-south-1); fs only locally.
STORAGE_DRIVER=fs
FS_STORAGE_DIR=./var/storage
# S3_BUCKET=threatready-private-ap-south-1
AWS_REGION=ap-south-1

# LLM: Anthropic only, through LlmPort. The app asks for tiers; these map tiers to verified ids.
# 'fake' is a deterministic offline driver for local demos and tests; refused in production.
LLM_DRIVER=fake
# ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-4-5
LLM_MODEL_LARGE=claude-sonnet-5-5
# LLM_REFUSAL_FALLBACK_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS_SMALL=20000
LLM_TIMEOUT_MS_LARGE=120000
LLM_MAX_RETRIES=2
LLM_VERIFY_MODELS_ON_BOOT=false
# Only for a model id not in the verified registry, after verifying it:
# LLM_PRICING_OVERRIDES={"claude-haiku-5-5":{"inputPerMTok":0.1,"outputPerMTok":0.5,"cacheReadPerMTok":0.01,"cacheWritePerMTok":0.125}}

# Tier-3 AI budget (USD) and quotas
AI_SESSION_CAP_USD=0.60
AI_FINAL_SCORING_RESERVE_USD=0.20
AI_USER_DAILY_CAP_USD=2
AI_GLOBAL_DAILY_CAP_USD=60
INTERVIEW_MONTHLY_QUOTA_FREE=5
INTERVIEW_MAX_OPEN_SESSIONS=2
RATE_LIMIT_SCALE=1

# Attack Reasoning (one monolith serves ar.threatready.io through its gateway)
REASONING_MAX_OPEN_ATTEMPTS=3
REASONING_MAX_GENERATION_TRIES=3
REASONING_SIMILARITY_THRESHOLD=0.35
REASONING_POOL_ENABLED=true
REASONING_POOL_TARGET=12
REASONING_POOL_MIN_AVAILABLE=4
REASONING_POOL_BATCH=4
REASONING_POOL_DAILY_CAP_USD=5
# Per learner per UTC day: answers evaluated (three LARGE calls each) and pool refills they may trigger.
REASONING_USER_DAILY_EVALUATIONS=20
REASONING_USER_DAILY_REFILLS=60

# Reports
REPORT_PDF_ENABLED=true
REPORT_EMAIL_ENABLED=false
EMAIL_DRIVER=log
# SES_FROM_ADDRESS=reports@threatready.io

# Observability
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# RELEASE=
# Vite dev proxy target when the API is not on :3000:  API_PROXY_TARGET=http://localhost:3100
