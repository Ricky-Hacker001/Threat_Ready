# ---- Copy to .env for local development. In AWS these come from SSM Parameter Store
# ---- (SecureString) and Secrets Manager (DATABASE_URL), injected by ECS at task start.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (RDS in AWS). The API login role must be a member of tr_app_user and must NOT have
# BYPASSRLS; the worker role owns the tables. Locally one role is fine.
DATABASE_URL=postgres://threatready:threatready@localhost:55432/threatready
# WORKER_DATABASE_URL=postgres://tr_worker:...@.../threatready

APP_ORIGIN=http://localhost:5174
# Other ThreatReady origins that call this API with the shared session: the Attack Reasoning app (ar.threatready.io).
ALLOWED_APP_ORIGINS=http://localhost:5176
API_BASE_URL=http://localhost:5174
# Signs local-storage (fs) upload and download links. Falls back to BETTER_AUTH_SECRET when unset.
# STORAGE_SIGNING_SECRET=
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-secret-for-local-development-only
# Header a trusted gateway sets with the visitor's IP (IP-keyed limits on public routes); unset = req.ip.
# CLIENT_IP_HEADER=x-threatready-client-ip
# Sign-in lives on onboard.threatready.io (ThreatReady identity provider); no local login.
IDENTITY_URL=http://localhost:3000
ONBOARD_URL=http://localhost:5173
# Same value as onboard's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=
# Per-caller internal tokens (security patch 2): the launcher derives them from INTERNAL_API_TOKEN and
# sets these itself. Unset locally: the raw INTERNAL_API_TOKEN is used both ways (accepted outside
# production unless INTERNAL_TOKEN_LEGACY_ACCEPT=false; never in production unless it is true).
# INTERNAL_TOKENS_ACCEPT=
# The only token the onboard-only routes accept (interview summary, AI usage, account erasure);
# required in production. INTERNAL_TOKENS_ACCEPT then opens just /internal/v1/reasoning/*.
# INTERNAL_TOKEN_FROM_ONBOARD=
# INTERNAL_TOKEN_TO_ONBOARD=
# INTERNAL_TOKEN_LEGACY_ACCEPT=
IDENTITY_CACHE_SECONDS=30
# Concurrent session lookups against onboard, in total and per client IP (0 = no cap). Past its share a
# client's lookups wait up to 2 s, then get a retryable 429. Cookies that are not a signed tr.session_token
# never cause a lookup; recently confirmed sessions are never shed.
IDENTITY_MAX_IN_FLIGHT=50
IDENTITY_MAX_IN_FLIGHT_PER_CLIENT=8

# Storage: s3 in every deployed environment (private bucket, ap-south-1); fs only locally.
STORAGE_DRIVER=fs
FS_STORAGE_DIR=./var/storage
# S3_BUCKET=threatready-private-ap-south-1
AWS_REGION=ap-south-1

# LLM: Anthropic only, through LlmPort. The app asks for tiers; these map tiers to verified ids.
# 'fake' is a deterministic offline driver for local demos and tests; refused in production.
LLM_DRIVER=fake
# ANTHROPIC_API_KEY=
# Required in production (no default there: the AI budgets are derived from its price).
LLM_MODEL_SMALL=claude-haiku-4-5
LLM_MODEL_LARGE=claude-sonnet-5-5
# LLM_REFUSAL_FALLBACK_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS_SMALL=20000
LLM_TIMEOUT_MS_LARGE=120000
LLM_MAX_RETRIES=2
LLM_VERIFY_MODELS_ON_BOOT=false
# Only for a model id not in the verified registry, after verifying it (claude-haiku-5-5 is in it). An
# override of a registered id changes only the fields it names; a new id gets no effort and 32k output tokens:
# LLM_PRICING_OVERRIDES={"<model-id>":{"inputPerMTok":0.1,"outputPerMTok":0.5,"cacheReadPerMTok":0.01,"cacheWritePerMTok":0.125}}

# Tier-3 AI budget (USD) and quotas
AI_SESSION_CAP_USD=0.60
AI_FINAL_SCORING_RESERVE_USD=0.20
AI_USER_DAILY_CAP_USD=2
AI_GLOBAL_DAILY_CAP_USD=60
# Final scoring (and later reasoning stages) per session or attempt across every retry (0 = no ceiling).
AI_FINALIZE_SOURCE_CAP_USD=1
# Monthly interviews; one cancelled after its analysis ran counts, one cancelled before does not.
INTERVIEW_MONTHLY_QUOTA_FREE=5
INTERVIEW_MAX_OPEN_SESSIONS=2
# Pauses a candidate may take per interview (0 = unlimited). Pauses and tab switches are shown in the report.
INTERVIEW_MAX_PAUSES=0
# Tier-2 rate limits per signed-in user (0 turns a class off; RATE_LIMIT_SCALE multiplies all, 0 = all off).
RATE_LIMIT_SCALE=1
INTERVIEW_RATE_GENERAL_PER_MIN=600
INTERVIEW_RATE_UPLOADS_PER_HOUR=10
INTERVIEW_RATE_JD_TEXTS_PER_HOUR=20
INTERVIEW_RATE_TEXT_EDITS_PER_HOUR=30
INTERVIEW_RATE_TURNS_PER_MIN=40
INTERVIEW_RATE_CREATES_PER_HOUR=10
REASONING_RATE_CREATES_PER_HOUR=10
# Local storage (fs) uploads: failed signature checks per client IP per 10 minutes, and uploads received
# at once (0 = no limit). Valid uploads are bounded by their single-use signed link, never by IP.
INTERVIEW_UPLOAD_FAILURES_PER_IP=30
INTERVIEW_UPLOAD_CONCURRENCY=16
# Downloads of the licensed 3D interviewer per user per UTC day (0 = no limit).
INTERVIEW_MODEL_DOWNLOADS_PER_DAY=30
# Where files and text are stored, as stated in the consent notice (unset: neutral wording, no location).
# INTERVIEW_DATA_STORAGE_LOCATION=Singapore

# Attack Reasoning (one monolith serves ar.threatready.io through its gateway)
REASONING_MAX_OPEN_ATTEMPTS=3
# Questions are written on the 15 reviewed architectures (apps/api/src/modules/reasoning/architectures).
# Model calls per question: try 1 on the first tier (SMALL = Haiku; LARGE puts Sonnet back as the writer),
# every later try on LARGE after the quality gate rejected the previous one.
REASONING_MAX_GENERATION_TRIES=2
REASONING_GENERATION_FIRST_TIER=SMALL
# Attack Reasoning's own SMALL model (the writer's first try, the stage-1 evaluator); default claude-haiku-5-5
# since the 27 Oct 2026 measurement (H55); claude-haiku-4-5 puts it back on Haiku 4.5. Interviews always
# use LLM_MODEL_SMALL. claude-haiku-5-5 thinks adaptively, so it gets more output room (16,000 tokens to write,
# 8,000 to grade) and longer timeouts (180 s, 120 s); when it declines a scenario (stop_reason refusal, billed)
# the question goes to the LARGE try and the answer to the LARGE review.
REASONING_MODEL_SMALL=claude-haiku-5-5
# Thinking depth of those SMALL calls (low, medium or high); sent only to a model that accepts it (not Haiku 4.5).
# Writing at low: on Haiku 5.5 it passed the quality gate more often than medium, cheaper and faster.
REASONING_SMALL_EFFORT_GENERATION=low
REASONING_SMALL_EFFORT_EVALUATION=medium
REASONING_SIMILARITY_THRESHOLD=0.35
# Items per architecture in the similarity bank; whether items generated before the library are still served.
REASONING_LIBRARY_BANK_SIZE=300
# Days a retired question stays in that bank (live questions and a learner's own always do).
REASONING_LIBRARY_BANK_DAYS=30
REASONING_SERVE_LEGACY_ITEMS=true
# Learners per question (then it retires; enforced atomically where the serve is recorded).
REASONING_ITEM_MAX_SERVES=2
# Evaluation: tiered = option scored in code + one SMALL pass, LARGE challenger/reconciler only for answers
# whose provisional score is within BAND of CENTER or that another escalation rule flags; full = three
# LARGE stages on every answer. Full by default since H55: tiered graded a reasoned wrong answer 12 points
# above full mode at high confidence, and waits for a larger agreement check (docs/ATTACK_REASONING_COST_DESIGN.md).
REASONING_EVALUATION_MODE=full
REASONING_ESCALATION_CENTER=60
REASONING_ESCALATION_BAND=8
# Share of answers no rule escalated that still get the second review, drawn at random (0 = off).
REASONING_ESCALATION_AUDIT_RATE=0.1
# Prompt caching for Attack Reasoning calls: off, since each stage's own output format invalidates the cache
# and the measured writes were never read back (+6% of spend). Turn on only with a design that shares one format.
REASONING_PROMPT_CACHE=false
# The question pool generates on a schedule (pool budget, below). Unset: on in production, off elsewhere.
# Off also removes the persisted */15 schedule at the next worker start. Leave off locally unless you
# are working on the pool: with a real ANTHROPIC_API_KEY it spends up to REASONING_POOL_DAILY_CAP_USD a day.
REASONING_POOL_ENABLED=false
# Buckets served in the last REASONING_POOL_DEMAND_DAYS are kept at the target, others at the idle target;
# the schedule grows a bucket up to REASONING_POOL_MAX_ITEMS while an active learner has fewer than
# REASONING_POOL_MIN_AVAILABLE questions left unseen.
REASONING_POOL_TARGET=8
REASONING_POOL_IDLE_TARGET=2
REASONING_POOL_DEMAND_DAYS=7
REASONING_POOL_MAX_ITEMS=24
REASONING_POOL_MIN_AVAILABLE=3
REASONING_POOL_BATCH=4
REASONING_POOL_DAILY_CAP_USD=5
# Per learner per UTC day: questions opened, answers evaluated, and pool questions their starts and
# prefetches may have generated (counted per question, not per refill job). 0 = no limit.
REASONING_USER_DAILY_QUESTIONS=12
REASONING_USER_DAILY_EVALUATIONS=20
REASONING_USER_DAILY_REFILLS=12
# Manual retries of a failed generation / evaluation per attempt (0 = no ceiling); hours an unanswered
# question stays open before it is skipped (0 = never).
REASONING_MAX_RETRIES=2
REASONING_READY_TTL_HOURS=24

# Reports
REPORT_PDF_ENABLED=true
REPORT_EMAIL_ENABLED=false
# 'log' only records that an email would be sent; production refuses it with REPORT_EMAIL_ENABLED=true.
EMAIL_DRIVER=log
# SES_FROM_ADDRESS=reports@threatready.io

# Observability
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# RELEASE=
# Vite dev proxy target when the API is not on :3000:  API_PROXY_TARGET=http://localhost:3100
