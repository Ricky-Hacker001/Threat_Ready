{
  "name": "threatready",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/contracts",
    "packages/db",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @threatready/shared -w @threatready/contracts -w @threatready/db && npm run build -w @threatready/api && npm run build -w @threatready/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "openapi": "npm run openapi -w @threatready/contracts",
    "db:migrate": "npm run migrate -w @threatready/db",
    "dev:api": "npm run dev -w @threatready/api",
    "dev:worker": "npm run dev:worker -w @threatready/api",
    "dev:web": "npm run dev -w @threatready/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0 <1"
    }
  }
}
