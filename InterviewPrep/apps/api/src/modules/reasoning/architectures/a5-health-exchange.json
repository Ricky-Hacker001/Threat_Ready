    { "id": "enclave-log", "label": "enclave output log", "nodeIds": ["enclave"], "records": "approved exports with reviewer", "gaps": null },
    {
      "id": "k8s-audit",
      "label": "platform cluster audit log",
      "nodeIds": ["k8s-api"],
      "records": "API requests including token and secret access",
      "gaps": null
    },
    {
      "id": "siem-feed",
      "label": "SOC SIEM",
      "nodeIds": ["siem"],
      "records": "FHIR audit events and cluster events",
      "gaps": "no portal or summariser logs"
    }
  ],
