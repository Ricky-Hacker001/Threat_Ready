# Local test account for the browser journeys (cross-browser.mjs) and manual walkthroughs. Copy to .env.
# Create it on the local onboard (http://localhost:5173) with EMAIL_DRIVER=log; the verification code
# appears in .logs/onboard-api.log. Development only; never a real person's account.
E2E_USER=ar.walkthrough
E2E_EMAIL=ar.walkthrough@threatready.test
E2E_PASSWORD=<set-your-own>
