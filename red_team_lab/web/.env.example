# ThreatReady Web Pentest Lab (standalone). Copy to .env.
PORT=4300
# This app's public origin. In dev that is the Vite dev server; in production it is the lab's URL.
# State-changing requests must come from it (Origin check).
APP_ORIGIN=http://localhost:5180
# Where learner progress is stored (atomic JSON file).
# DATA_FILE=./data/store.json

# ---- Standalone dev sign-in ----
# When true (the default on localhost), a cookie-based local login is offered so the lab runs
# without the ThreatReady identity provider. Set a stable APP_SECRET to keep dev sessions across restarts.
DEV_LOGIN=true
# APP_SECRET=change-me-to-a-long-random-string

# ---- Platform mode (optional; used only when DEV_LOGIN=false) ----
# Forward the shared *.threatready.io session to onboard (identity provider) for platform parity.
# ONBOARD_URL=http://localhost:5173
# IDENTITY_URL=http://localhost:3000
# INTERNAL_API_TOKEN=
# IDENTITY_CACHE_SECONDS=30
# Concurrent onboard lookups in total / per client IP (0 = no cap). Past the per-client cap a lookup
# waits up to 5 s; a session onboard confirmed in the last 12 h is never shed.
# REDTEAM_IDENTITY_MAX_IN_FLIGHT=50
# REDTEAM_IDENTITY_MAX_PER_CLIENT=16

# ---- Limits (0 disables each) ----
# Requests per minute per signed-in learner, and per client IP for traffic not yet recognised.
# REDTEAM_RATE_PER_MIN=120
# REDTEAM_RATE_IP_PER_MIN=300
# Newest runs kept per learner and lab; older archived runs are dropped.
# REDTEAM_MAX_RUNS_PER_LAB=20
# Set to 1 only when a proxy in front overwrites x-threatready-client-ip on every request; otherwise a
# client-sent value is dropped and the connection address is used.
# REDTEAM_TRUST_CLIENT_IP_HEADER=
